{
  "name": "chatbot-automation",
  "private": true,
  "scripts": {
    "clean": "rimraf reports screenshots videos logs",
    "test:smoke:keepme": "node scripts/run-smoke.ts \"@smoke and (@KeepmeCRM or @KeepmeAPI or @controlcentre)\"",
    "test:smoke:perfectgym": "node scripts/run-smoke.ts \"@smoke and (@PerfectgymCRM or @PerfectgymAPI or @controlcentre)\"",
    "test:headed": "cross-env HEADLESS=false cucumber-js --tags @smoke",
    "test:debug": "cross-env HEADLESS=false KEEP_BROWSER_OPEN=true cucumber-js --tags @smoke",
    "test:ci": "cross-env HEADLESS=true cucumber-js --tags @regression",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:chatbot:dev": "cross-env ENV=agentdev CLIENT=testDemoClientDev node scripts/run-smoke.ts \"@controlcentre\"",
    "test:chatbot:staging": "cross-env ENV=staging CLIENT=demoAccountStaging node scripts/run-smoke.ts \"@controlcentre\"",
    "test:chatbot:prod": "cross-env ENV=prod CLIENT=demoAccountProd node scripts/run-smoke.ts \"@controlcentre\"",
    "test:chatbot:all": "yarn test:chatbot:dev; yarn test:chatbot:staging; yarn test:chatbot:prod",
    "report:chatbot:dev": "cross-env ENV=agentdev CLIENT=testDemoClientDev ts-node scripts/generate-report.ts",
    "report:chatbot:staging": "cross-env ENV=staging CLIENT=demoAccountStaging ts-node scripts/generate-report.ts",
    "report:chatbot:prod": "cross-env ENV=prod CLIENT=demoAccountProd ts-node scripts/generate-report.ts",
    "test:dev": "yarn test:chatbot:dev",
    "test:staging": "yarn test:chatbot:staging",
    "test:prod": "yarn test:chatbot:prod",
    "test:dev:ci": "cross-env HEADLESS=true yarn test:chatbot:dev",
    "test:staging:ci": "cross-env HEADLESS=true yarn test:chatbot:staging",
    "test:prod:ci": "cross-env HEADLESS=true yarn test:chatbot:prod",
    "summary": "ts-node scripts/ci-summary.ts dev=testDemoClientDev staging=demoAccountStaging prod=demoAccountProd",
    "typecheck": "tsc --noEmit -p .",
    "browsers:install": "playwright install chromium chromium-headless-shell",
    "test:smoke-yarn": "yarn pretest; cucumber-js --tags @smoke; yarn posttest",
    "test:reg-yarn": "yarn pretest; cucumber-js --tags @regression; yarn posttest",
    "pretest": "yarn clean && mkdirp reports",
    "test": "cucumber-js",
    "posttest": "ts-node scripts/generate-report.ts",
    "test:smoke": "yarn pretest; cucumber-js --tags @smoke; yarn posttest",
    "test:reg": "yarn pretest; cucumber-js --tags @regression; yarn posttest",
    "test:all": "yarn pretest; cucumber-js --tags \"@smoke or @regression or @fallback or @critical or @sanity\"; yarn posttest"
  },
  "devDependencies": {
    "@cucumber/cucumber": "10.3.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.19.39",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "dotenv": "16.4.5",
    "multiple-cucumber-html-reporter": "^3.9.3",
    "rimraf": "5.0.5",
    "ts-node": "10.9.2",
    "typescript": "5.3.3",
    "winston": "3.11.0"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "yarn": "^1.22.22"
  }
}
